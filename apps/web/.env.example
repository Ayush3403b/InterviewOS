# Base URL of the InterviewOS backend (no trailing slash, no /api suffix)
VITE_API_URL=http://localhost:5000

# reCAPTCHA v2 site key (the public one, not the secret). Leave unset
# for local dev - the login/register forms work without it, matching
# the backend's CAPTCHA_PROVIDER=none default. Get one at
# https://www.google.com/recaptcha/admin
VITE_CAPTCHA_SITE_KEY=
