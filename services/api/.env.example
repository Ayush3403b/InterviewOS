PORT=

MONGO_URI=

# Generate a real, unique secret per environment - never reuse this
# across dev/staging/prod, and never commit an actual value here.
# A quick way to generate one: `openssl rand -hex 32`
JWT_SECRET=

JWT_EXPIRES_IN=15m

CLIENT_URL=

# SMTP is required (verification emails, password reset) - point this
# at a local dev catcher (e.g. Mailhog/Mailpit) if you don't want to
# use a real provider while developing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# AI evaluation provider: claude | openai | gemini | mock
AI_EVALUATION_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional ordered fallback chain if the primary provider fails, e.g. "openai,gemini"
AI_FALLBACK_PROVIDERS=

# Network-level retries per provider call
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=500

# Full generate+validate cycles retried if the model's JSON fails schema validation
AI_VALIDATION_RETRY_ATTEMPTS=2

# Rate limiting - all optional, sensible defaults apply if unset.
# Auth endpoints (login/register/password-reset/etc), keyed by IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Proctoring signal ingestion (REST fallback + the Socket.IO path),
# keyed by user. Sized generously above the client's ~3s tick cadence.
SIGNAL_RATE_LIMIT_WINDOW_MS=10000
SIGNAL_RATE_LIMIT_MAX=20

# Baseline for everything under /api/v1, keyed by user (falls back to IP).
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600

# Resume grammar-check/rewrite - each call hits an LLM in LLM mode,
# so this is tighter than the general API baseline (cost, not safety).
RESUME_WRITER_RATE_LIMIT_WINDOW_MS=300000
RESUME_WRITER_RATE_LIMIT_MAX=15

# AI MCQ generation (from topics, or from uploaded PDFs/images) - the
# most expensive AI call in the app, so the tightest limit.
MCQ_GENERATION_RATE_LIMIT_WINDOW_MS=600000
MCQ_GENERATION_RATE_LIMIT_MAX=20

# CAPTCHA on register/login - "none" (default) skips verification
# entirely, which is fine for local dev/CI but not for anything
# reachable from the public internet. Set a real provider + secret
# before that. "recaptcha" and "hcaptcha" both work - see
# CaptchaVerifier.ts.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=

# How long a session can sit IN_PROGRESS with no activity, or PAUSED
# with no resume, before it's auto-expired (see InterviewStatus.EXPIRED).
INTERVIEW_IN_PROGRESS_TIMEOUT_MINUTES=60
INTERVIEW_PAUSED_TIMEOUT_HOURS=24
